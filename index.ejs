<!DOCTYPE html>
<html>
<head>
  <title>SpiderFit – Energy a Gym doplňky</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
  <h1 class="text-danger">SpiderFit – Fitness produkty a energy</h1>
  <% if (user) { %>
    <p>Vítej <strong><%= user.username %></strong> (<%= isVip ? "VIP zákazník" : "běžný zákazník" %>)
    | <a href="/cart">Košík</a> | <a href="/logout">Odhlásit</a></p>
  <% } else { %>
    <a href="/login">Přihlásit</a> | <a href="/register">Registrovat</a>
  <% } %>

  <div class="row">
    <% products.forEach(p => { %>
      <div class="col-md-4 mb-3">
        <div class="card">
          <img src="/images/<%= p.image %>" class="card-img-top" alt="<%= p.name %>">
          <div class="card-body">
            <h5 class="card-title"><%= p.name %></h5>
            <p class="card-text"><%= isVip ? (p.price * 0.7).toFixed(2) : p.price.toFixed(2) %> Kč</p>
            <% if (user) { %>
              <form method="POST" action="/cart/add">
                <input type="hidden" name="product_id" value="<%= p.id %>">
                <button class="btn btn-primary">Přidat do košíku</button>
              </form>
            <% } %>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
</body>
</html>
