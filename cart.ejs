<!DOCTYPE html>
<html>
<head>
  <title>Košík – SpiderFit</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-5">
  <h1>Váš košík – SpiderFit</h1>
  <a href="/" class="btn btn-secondary mb-3">Zpět do obchodu</a>
  <% if (items.length === 0) { %>
    <p>Košík je prázdný.</p>
  <% } else { %>
    <table class="table">
      <thead>
        <tr>
          <th>Produkt</th>
          <th>Cena za kus</th>
          <th>Množství</th>
          <th>Celkem</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(item => { 
          let price = item.price;
          if (isVip) price *= 0.7;
          if (item.quantity >= 10) price *= 0.9;
          const totalItem = (price * item.quantity).toFixed(2);
        %>
          <tr>
            <td><%= item.name %></td>
            <td><%= price.toFixed(2) %> Kč</td>
            <td><%= item.quantity %></td>
            <td><%= totalItem %> Kč</td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <h4>Celková cena: <%= total.toFixed(2) %> Kč</h4>
  <% } %>
</body>
</html>
